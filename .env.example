# Copy this file to .env for local development. Never commit the real key.
# Choose one provider. When multiple keys exist, LLM_PROVIDER decides which one is used.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Anthropic alternative:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_CODE_MODEL=claude-sonnet-5
CLAUDE_CODE_RESEARCH_BUDGET_USD=1.00
CLAUDE_CODE_CHAT_BUDGET_USD=0.10
LIVE_RESEARCH_MAX_SEARCHES=4
LIVE_RESEARCH_MAX_OUTPUT_TOKENS=10000

# Vector RAG crawl/index limits. Documents are unique downloaded web pages or PDFs.
RAG_MAX_DOCUMENTS=30
RAG_MAX_PAGES_PER_DOMAIN=8
RAG_MAX_DOCUMENT_BYTES=3000000
RAG_MAX_CRAWL_SECONDS=30
RAG_CRAWL_WORKERS=8
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SIMILARITY=0.40
# BENCHMIND_VECTOR_DB_PATH=.benchmind/chroma

# FastAPI / Docker deployment. Generate a different token with: openssl rand -hex 32
# BENCHMIND_API_URL=http://127.0.0.1:8000
# BENCHMIND_API_TOKEN=replace_with_a_long_random_value
# APP_DOMAIN=benchmind.example.com
# API_DOMAIN=api.benchmind.example.com

# Optional OpenAI alternative:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5.6-sol
