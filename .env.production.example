LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

LIVE_RESEARCH_MAX_OUTPUT_TOKENS=6000
LIVE_RESEARCH_MAX_SEARCHES=5

BENCHMIND_API_TOKEN=replace_with_output_of_openssl_rand_hex_32

# Use plain HTTP on the static IP until a domain is connected.
APP_DOMAIN=:80
API_DOMAIN=api.localhost

APP_AUTH_USER=benchmind
# Keep the Caddy bcrypt hash in single quotes so dollar signs stay literal.
APP_AUTH_PASSWORD_HASH='$2a$14$replace_with_output_of_caddy_hash_password'
